OPENAI_API_KEY=sk-...           # the OpenAI chat model (embeddings are local)
# Another chat provider (install its extra: pip install 'profile-match[anthropic]'):
# LLM_PROVIDER=openai            # openai, anthropic, google or ollama
# ANTHROPIC_API_KEY=sk-ant-...   # or GOOGLE_API_KEY=...; Ollama needs none
# LLM_MODEL=                     # default: gpt-5.6-terra, claude-opus-5-5, gemini-3.1-pro; required for ollama
# LLM_BASE_URL=                  # an OpenAI-compatible server (openai provider) or the Ollama server
# LLM_API_KEY=                   # that server's key; OPENAI_API_KEY is never sent to it
# LLM_TEMPERATURE=0              # unset = provider default (Claude and newer models accept no other value)
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2
# OPENAI_RESPONSES_API=true      # default: on for OpenAI, off with LLM_BASE_URL
# EMBEDDER=local                # local (default), openai, or hashing (keyword overlap only, for tests)
# LOCAL_EMBEDDING_MODEL=ibm-granite/granite-embedding-small-english-r2   # or snowflake/snowflake-arctic-embed-m
# MODELS_DIR=~/.profile-match/models
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # with EMBEDDER=openai
# PROFILE_MATCH_HOME=~/.profile-match   # local data: indexes, uploads, sessions
# INDEX_DIR=~/.profile-match/index
# SESSIONS_DB=~/.profile-match/sessions.sqlite
# UPLOADS_DIR=~/.profile-match/uploads   # where resumes given as files are copied
# REPORTS_DIR=reports           # the only directory the agent may write to
# SHORTLIST_SIZE=10             # candidates kept after the initial screen
# SCREENING_ROUNDS=3           # 1 retrieval only, 2 + deep analysis, 3 + hire/no-hire
# SAVE_REPORTS=true             # save summary + per-candidate reports after every screening
