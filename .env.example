OPENAI_API_KEY=sk-...
# Optional: override the defaults
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TEMPERATURE=0          # unset = provider default (gpt-6-luna accepts no other value)
# OPENAI_TIMEOUT=60
# OPENAI_MAX_RETRIES=2
# OPENAI_RESPONSES_API=true      # needed for tool calling with reasoning models
# PROFILE_MATCH_HOME=~/.profile-match   # local data: indexes, uploads, sessions
# CHROMA_DB_DIR=~/.profile-match/index
# SESSIONS_DB=~/.profile-match/sessions.sqlite
# UPLOADS_DIR=~/.profile-match/uploads   # where resumes given as files are copied
# EMBEDDER=openai                # or hashing: offline, keyword overlap only
# REPORTS_DIR=reports           # the only directory the agent may write to
# SHORTLIST_SIZE=10             # candidates kept after the initial screen
# SCREENING_ROUNDS=3           # 1 retrieval only, 2 + deep analysis, 3 + hire/no-hire
# SAVE_REPORTS=true             # save summary + per-candidate reports after every screening
